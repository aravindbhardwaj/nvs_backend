APP_NAME=
APP_PORT=
NODE_ENV=

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

DATABASE_URL=

UPLOAD_PATH=
MAX_FILE_SIZE=
MAX_UPLOAD_SIZE=10485760
BANNER_UPLOAD_PATH=resources/banner_uploads
CKEDITOR_IMAGE_UPLOAD_PATH=resources/ckeditor_image_uploads
# Optional public origin used in returned CKEditor image URLs (for example https://api.example.com)
CKEDITOR_IMAGE_BASE_URL=
ORGANIZATION_PROFILE_IMAGE_UPLOAD_PATH=resources/organization_profile_images
# Optional public origin used in returned organization image URLs
ORGANIZATION_PROFILE_IMAGE_BASE_URL=
BANNER_MAX_UPLOAD_SIZE=5242880
MAX_BANNERS_PER_ORGANIZATION=5

BCRYPT_ROUNDS=
PASSWORD_PRIVATE_KEY_PATH=.secrets/password-private.pem

MAX_LOGIN_ATTEMPTS=
ACCOUNT_LOCK_MINUTES=

# Per-IP request limits. Authentication defaults to 5 requests/minute;
# visitor capture defaults to 100 requests/minute.
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
VISITOR_RATE_LIMIT_TTL_MS=60000
VISITOR_RATE_LIMIT_MAX_REQUESTS=100

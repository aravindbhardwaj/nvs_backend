generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HEADQUARTER
  NLI
  REGIONAL
  JNV
}

enum OrganizationType {
  HEADQUARTER
  NLI
  REGIONAL_OFFICE
  JNV
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model Region {
  id          Int       @id @default(autoincrement())
  regionName  String    @unique @map("region_name") @db.VarChar(150)
  regionCode  String    @unique @map("region_code") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById Int?      @map("created_by")
  updatedById Int?      @map("updated_by")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById Int?      @map("deleted_by")

  createdBy     User?          @relation("RegionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("RegionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy     User?          @relation("RegionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  organizations Organization[]

  @@index([regionCode])
  @@index([isDeleted])
  @@map("nvs_regions")
}

model State {
  id          Int       @id @default(autoincrement())
  stateName   String    @unique @map("state_name") @db.VarChar(150)
  stateCode   String    @unique @map("state_code") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById Int?      @map("created_by")
  updatedById Int?      @map("updated_by")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById Int?      @map("deleted_by")

  createdBy     User?          @relation("StateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("StateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy     User?          @relation("StateDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  organizations Organization[]

  @@index([stateCode])
  @@index([isDeleted])
  @@map("nvs_states")
}

model Organization {
  id                   Int              @id @default(autoincrement())
  organizationName     String           @map("organization_name") @db.VarChar(255)
  organizationCode     String           @unique @map("organization_code") @db.VarChar(30)
  organizationType     OrganizationType @map("organization_type")
  parentOrganizationId Int?             @map("parent_organization_id")
  regionId             Int?             @map("region_id")
  stateId              Int?             @map("state_id")
  address              String?          @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  createdById          Int?             @map("created_by")
  updatedById          Int?             @map("updated_by")
  isDeleted            Boolean          @default(false) @map("is_deleted")
  deletedAt            DateTime?        @map("deleted_at")
  deletedById          Int?             @map("deleted_by")

  parentOrganization Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: Restrict)
  childOrganizations Organization[] @relation("OrganizationHierarchy")
  region             Region?        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  state              State?         @relation(fields: [stateId], references: [id], onDelete: Restrict)
  createdBy          User?          @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?          @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy          User?          @relation("OrganizationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  users              User[]         @relation("UserOrganization")
  pages              Page[]
  media              Media[]
  banners            Banner[]
  galleryImages      GalleryImage[]

  @@index([organizationCode])
  @@index([organizationType])
  @@index([parentOrganizationId])
  @@index([regionId])
  @@index([stateId])
  @@index([isDeleted])
  @@map("nvs_organizations")
}

model User {
  id                    Int        @id @default(autoincrement())
  name                  String     @db.VarChar(150)
  email                 String     @unique @db.VarChar(255)
  passwordHash          String     @map("password") @db.VarChar(255)
  mobile                String?    @db.VarChar(20)
  address               String?    @db.Text
  role                  Role
  organizationId        Int        @map("organization_id")
  status                UserStatus @default(ACTIVE)
  failedLoginAttempts   Int        @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?  @map("locked_until")
  lastLoginAt           DateTime?  @map("last_login_at")
  sessionVersion        Int        @default(0) @map("session_version")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  createdById           Int?       @map("created_by")
  updatedById           Int?       @map("updated_by")
  isDeleted             Boolean    @default(false) @map("is_deleted")
  deletedAt             DateTime?  @map("deleted_at")
  deletedById           Int?       @map("deleted_by")
  passwordResetRequired Boolean    @default(false) @map("password_reset_required")
  passwordChangedAt     DateTime?  @map("password_changed_at")

  organization           Organization     @relation("UserOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User?            @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?            @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy              User?            @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdUsers           User[]           @relation("UserCreatedBy")
  updatedUsers           User[]           @relation("UserUpdatedBy")
  deletedUsers           User[]           @relation("UserDeletedBy")
  createdRegions         Region[]         @relation("RegionCreatedBy")
  updatedRegions         Region[]         @relation("RegionUpdatedBy")
  deletedRegions         Region[]         @relation("RegionDeletedBy")
  createdStates          State[]          @relation("StateCreatedBy")
  updatedStates          State[]          @relation("StateUpdatedBy")
  deletedStates          State[]          @relation("StateDeletedBy")
  createdOrganizations   Organization[]   @relation("OrganizationCreatedBy")
  updatedOrganizations   Organization[]   @relation("OrganizationUpdatedBy")
  deletedOrganizations   Organization[]   @relation("OrganizationDeletedBy")
  createdContentTypes    ContentType[]    @relation("ContentTypeCreatedBy")
  updatedContentTypes    ContentType[]    @relation("ContentTypeUpdatedBy")
  deletedContentTypes    ContentType[]    @relation("ContentTypeDeletedBy")
  createdMediaTypes      MediaType[]      @relation("MediaTypeCreatedBy")
  updatedMediaTypes      MediaType[]      @relation("MediaTypeUpdatedBy")
  deletedMediaTypes      MediaType[]      @relation("MediaTypeDeletedBy")
  createdPages           Page[]           @relation("PageCreatedBy")
  updatedPages           Page[]           @relation("PageUpdatedBy")
  deletedPages           Page[]           @relation("PageDeletedBy")
  createdMedia           Media[]          @relation("MediaCreatedBy")
  updatedMedia           Media[]          @relation("MediaUpdatedBy")
  deletedMedia           Media[]          @relation("MediaDeletedBy")
  createdBanners         Banner[]         @relation("BannerCreatedBy")
  updatedBanners         Banner[]         @relation("BannerUpdatedBy")
  deletedBanners         Banner[]         @relation("BannerDeletedBy")
  createdGalleryImages   GalleryImage[]   @relation("GalleryImageCreatedBy")
  updatedGalleryImages   GalleryImage[]   @relation("GalleryImageUpdatedBy")
  deletedGalleryImages   GalleryImage[]   @relation("GalleryImageDeletedBy")
  createdUserPermissions UserPermission[] @relation("UserPermissionCreatedBy")
  refreshTokens          RefreshToken[]
  userPermissions        UserPermission[] @relation("UserPermissionUser")
  auditLogs              AuditLog[]

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@map("nvs_users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("refresh_token") @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("nvs_refresh_tokens")
}

model ContentType {
  id           Int       @id @default(autoincrement())
  name         String    @unique @db.VarChar(150)
  description  String?   @db.Text
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  Int?      @map("created_by")
  updatedById  Int?      @map("updated_by")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by")

  createdBy User?  @relation("ContentTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("ContentTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User?  @relation("ContentTypeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  pages     Page[]

  @@index([displayOrder])
  @@index([isDeleted])
  @@map("nvs_content_types")
}

model MediaType {
  id           Int       @id @default(autoincrement())
  name         String    @unique @db.VarChar(150)
  description  String?   @db.Text
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  Int?      @map("created_by")
  updatedById  Int?      @map("updated_by")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by")

  createdBy User?   @relation("MediaTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("MediaTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy User?   @relation("MediaTypeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  media     Media[]

  @@index([displayOrder])
  @@index([isDeleted])
  @@map("nvs_media_types")
}

model Page {
  id               Int        @id @default(autoincrement())
  organizationId   Int        @map("organization_id")
  contentTypeId    Int        @map("content_type_id")
  title            String     @db.VarChar(255)
  slug             String     @unique @db.VarChar(255)
  shortDescription String?    @map("short_description") @db.Text
  content          String     @db.Text
  status           PageStatus @default(DRAFT)
  displayOrder     Int        @default(0) @map("display_order")
  publishedAt      DateTime?  @map("published_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  createdById      Int?       @map("created_by")
  updatedById      Int?       @map("updated_by")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  deletedAt        DateTime?  @map("deleted_at")
  deletedById      Int?       @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contentType  ContentType  @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?        @relation("PageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, contentTypeId])
  @@index([organizationId])
  @@index([contentTypeId])
  @@index([status])
  @@index([displayOrder])
  @@index([isDeleted])
  @@map("nvs_pages")
}

model Media {
  id               Int       @id @default(autoincrement())
  organizationId   Int       @map("organization_id")
  mediaTypeId      Int       @map("media_type_id")
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  originalFilename String    @map("original_filename") @db.VarChar(255)
  storedFilename   String    @unique @map("stored_filename") @db.VarChar(255)
  filePath         String    @map("file_path") @db.VarChar(500)
  mimeType         String    @map("mime_type") @db.VarChar(100)
  extension        String    @db.VarChar(20)
  fileSize         BigInt    @map("file_size")
  checksum         String?   @db.VarChar(255)
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdById      Int?      @map("created_by")
  updatedById      Int?      @map("updated_by")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  deletedById      Int?      @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mediaType    MediaType    @relation(fields: [mediaTypeId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("MediaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?        @relation("MediaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([mediaTypeId])
  @@index([mimeType])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("nvs_media")
}

model Banner {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  altText        String?   @map("alt_text") @db.VarChar(255)
  storedFilename String    @unique @map("stored_filename") @db.VarChar(255)
  imagePath      String    @map("image_path") @db.VarChar(500)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  extension      String    @db.VarChar(20)
  fileSize       BigInt    @map("file_size")
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    Int?      @map("created_by")
  updatedById    Int?      @map("updated_by")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    Int?      @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BannerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BannerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?        @relation("BannerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([isActive])
  @@index([displayOrder])
  @@index([organizationId, isActive, displayOrder])
  @@index([isDeleted])
  @@map("nvs_banners")
}

model GalleryImage {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  altText        String?   @map("alt_text") @db.VarChar(255)
  storedFilename String    @unique @map("stored_filename") @db.VarChar(255)
  imagePath      String    @map("image_path") @db.VarChar(500)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  extension      String    @map("extension") @db.VarChar(20)
  fileSize       BigInt    @map("file_size")
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    Int?      @map("created_by")
  updatedById    Int?      @map("updated_by")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    Int?      @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("GalleryImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("GalleryImageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy    User?        @relation("GalleryImageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([isActive])
  @@index([displayOrder])
  @@index([organizationId, isActive, displayOrder])
  @@index([isDeleted])
  @@map("nvs_gallery_images")
}

model Permission {
  id            Int      @id @default(autoincrement())
  permissionKey String   @unique @map("permission_key") @db.VarChar(150)
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([permissionKey])
  @@index([module])
  @@map("nvs_permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  role         Role
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("nvs_role_permissions")
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  permissionId Int      @map("permission_id")
  allowed      Boolean  @map("allowed")
  createdAt    DateTime @default(now()) @map("created_at")
  createdById  Int?     @map("created_by")

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("UserPermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("nvs_user_permissions")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  module         String   @db.VarChar(100)
  entity         String   @db.VarChar(100)
  entityId       Int?     @map("entity_id")
  action         String   @db.VarChar(100)
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(100)
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([module])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("nvs_audit_logs")
}

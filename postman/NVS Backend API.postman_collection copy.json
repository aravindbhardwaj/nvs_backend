        { "name": "Replace user overrides", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"permissions\": [\n    { \"permissionId\": 1, \"allowed\": true },\n    { \"permissionId\": 2, \"allowed\": false }\n  ]\n}" }, "url": "{{baseUrl}}/api/user-permissions/{{userId}}" } },
        { "name": "Delete user overrides", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/user-permissions/{{userId}}" } }

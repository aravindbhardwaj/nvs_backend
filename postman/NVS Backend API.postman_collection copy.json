        { "name": "Get image", "request": { "method": "GET", "url": "{{baseUrl}}/api/gallery/{{galleryImageId}}/image" } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated gallery image\",\n  \"description\": \"Updated description\",\n  \"altText\": \"Updated gallery image\",\n  \"displayOrder\": 2,\n  \"isActive\": true\n}" }, "url": "{{baseUrl}}/api/gallery/{{galleryImageId}}" } },
        { "name": "Replace image", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "{{imageFilePath}}" }] }, "url": "{{baseUrl}}/api/gallery/{{galleryImageId}}/image" } },
        { "name": "Reorder", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"images\": [\n    { \"id\": {{galleryImageId}}, \"displayOrder\": 1 }\n  ]\n}" }, "url": "{{baseUrl}}/api/gallery/reorder" } },
        { "name": "Bulk delete", "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ids\": [{{galleryImageId}}]\n}" }, "url": "{{baseUrl}}/api/gallery/bulk" } },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/gallery/{{galleryImageId}}" } }
      ]
    },
    {

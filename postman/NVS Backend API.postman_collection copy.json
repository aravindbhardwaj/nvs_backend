        { "name": "Create", "description": "SUPER_ADMIN: set targetOrganizationId to upload for a target organization.", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "{{imageFilePath}}" }, { "key": "organizationId", "value": "{{targetOrganizationId}}", "type": "text" }, { "key": "title", "value": "Sample banner", "type": "text" }, { "key": "description", "value": "Sample banner description", "type": "text" }, { "key": "altText", "value": "Sample banner", "type": "text" }, { "key": "displayOrder", "value": "1", "type": "text" }, { "key": "isActive", "value": "true", "type": "text" }] }, "url": "{{baseUrl}}/api/banners" } },
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/banners?page=1&limit=20&organizationId={{targetOrganizationId}}" } },

  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Login", "event": [{ "listen": "test", "script": { "exec": ["const response = pm.response.json();", "pm.collectionVariables.set('access_token', response.data.accessToken);", "pm.collectionVariables.set('refresh_token', response.data.refreshToken);"] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Refresh token", "event": [{ "listen": "test", "script": { "exec": ["const response = pm.response.json();", "pm.collectionVariables.set('access_token', response.data.accessToken);", "pm.collectionVariables.set('refresh_token', response.data.refreshToken);"] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" }, "url": "{{baseUrl}}/api/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" }, "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"organizationName\": \"Sample Organization\",\n  \"organizationCode\": \"SAMPLE-ORG\",\n  \"organizationType\": \"JNV\",\n  \"parentOrganizationId\": 1,\n  \"regionId\": 1,\n  \"stateId\": 1,\n  \"address\": \"Sample address\"\n}" }, "url": "{{baseUrl}}/api/organizations" } },
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations?page=1&limit=20" } },
        { "name": "Get by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations/{{organizationId}}" } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"organizationName\": \"Updated Organization\",\n  \"organizationCode\": \"UPDATED-ORG\",\n  \"organizationType\": \"JNV\",\n  \"parentOrganizationId\": 1,\n  \"regionId\": 1,\n  \"stateId\": 1\n}" }, "url": "{{baseUrl}}/api/organizations/{{organizationId}}" } },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/organizations/{{organizationId}}" } },
        { "name": "Restore", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/organizations/{{organizationId}}/restore" } }

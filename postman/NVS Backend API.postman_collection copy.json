        { "name": "Replace image", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "{{imageFilePath}}" }] }, "url": "{{baseUrl}}/api/banners/{{bannerId}}/image" } },
        { "name": "Activate", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/banners/{{bannerId}}/activate" } },
        { "name": "Deactivate", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/banners/{{bannerId}}/deactivate" } },

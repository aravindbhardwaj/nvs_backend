    {
      "name": "Gallery",
      "item": [
        { "name": "Create", "description": "SUPER_ADMIN: set targetOrganizationId to upload for a target organization.", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "{{imageFilePath}}" }, { "key": "organizationId", "value": "{{targetOrganizationId}}", "type": "text" }, { "key": "title", "value": "Sample gallery image", "type": "text" }, { "key": "description", "value": "Sample gallery description", "type": "text" }, { "key": "altText", "value": "Sample gallery image", "type": "text" }, { "key": "displayOrder", "value": "1", "type": "text" }, { "key": "isActive", "value": "true", "type": "text" }] }, "url": "{{baseUrl}}/api/gallery" } },
        { "name": "Bulk upload", "description": "Select one or more images. SUPER_ADMIN can set targetOrganizationId.", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "images", "type": "file", "src": "{{imageFilePath}}" }, { "key": "organizationId", "value": "{{targetOrganizationId}}", "type": "text" }, { "key": "title", "value": "Sample gallery image", "type": "text" }, { "key": "displayOrder", "value": "1", "type": "text" }, { "key": "isActive", "value": "true", "type": "text" }] }, "url": "{{baseUrl}}/api/gallery/bulk-upload" } },
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/gallery?page=1&limit=20&organizationId={{targetOrganizationId}}" } },

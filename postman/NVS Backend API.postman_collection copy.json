      "item": [
        { "name": "Upload", "description": "SUPER_ADMIN: choose the target Headquarters, NLI, Regional Office, or JNV using targetOrganizationId. Other roles can upload only for their own organization.", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{filePath}}" }, { "key": "title", "value": "Sample document", "type": "text" }, { "key": "description", "value": "Sample upload", "type": "text" }, { "key": "mediaTypeId", "value": "{{mediaTypeId}}", "type": "text" }, { "key": "organizationId", "value": "{{targetOrganizationId}}", "type": "text" }] }, "url": "{{baseUrl}}/api/media/upload" } },
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/media?page=1&limit=20&organizationId={{targetOrganizationId}}" } },
        { "name": "Download", "request": { "method": "GET", "url": "{{baseUrl}}/api/media/{{mediaId}}/download" } },
        { "name": "Get by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/media/{{mediaId}}" } },
        { "name": "Replace file", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{filePath}}" }] }, "url": "{{baseUrl}}/api/media/{{mediaId}}/file" } },
        { "name": "Update metadata", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated document\",\n  \"description\": \"Updated description\",\n  \"mediaTypeId\": 1\n}" }, "url": "{{baseUrl}}/api/media/{{mediaId}}" } },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/media/{{mediaId}}" } },
        { "name": "Restore", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/media/{{mediaId}}/restore" } }
      ]

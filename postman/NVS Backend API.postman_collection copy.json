    {
      "name": "Pages",
      "item": [
        { "name": "Create", "description": "SUPER_ADMIN: choose the target organization with targetOrganizationId. Other roles can create pages only for their own organization.", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"organizationId\": {{targetOrganizationId}},\n  \"contentTypeId\": {{contentTypeId}},\n  \"title\": \"Sample Page\",\n  \"shortDescription\": \"Sample summary\",\n  \"content\": \"Sample page content\",\n  \"status\": \"DRAFT\",\n  \"displayOrder\": 100\n}" }, "url": "{{baseUrl}}/api/pages" } },
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/pages?page=1&limit=20&organizationId={{targetOrganizationId}}" } },
        { "name": "Get by slug", "request": { "method": "GET", "url": "{{baseUrl}}/api/pages/slug/{{slug}}" } },
        { "name": "Get by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/pages/{{pageId}}" } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Page\",\n  \"content\": \"Updated page content\",\n  \"displayOrder\": 101\n}" }, "url": "{{baseUrl}}/api/pages/{{pageId}}" } },
        { "name": "Publish", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/pages/{{pageId}}/publish" } },

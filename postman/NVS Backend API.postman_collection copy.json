        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/media-types/{{mediaTypeId}}" } },
        { "name": "Restore", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/media-types/{{mediaTypeId}}/restore" } }
      ]

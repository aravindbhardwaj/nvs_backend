        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Content Type\",\n  \"description\": \"Updated description\",\n  \"displayOrder\": 101\n}" }, "url": "{{baseUrl}}/api/content-types/{{contentTypeId}}" } },

                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"Updated Organization\",\n  \"organizationCode\": \"UPDATED-ORG\",\n  \"organizationTypeId\": {{organizationTypeId}},\n  \"parentOrganizationId\": {{regionalOfficeId}},\n  \"regionId\": {{regionId}},\n  \"stateId\": {{stateId}}\n}"

    {
      "name": "Media",
      "item": [
        {
          "name": "Upload",
          "description": "SUPER_ADMIN: choose the target Headquarters, NLI, Regional Office, or JNV using targetOrganizationId. Other roles can upload only for their own organization. Add hindiFile to store a second Hindi document on the same media record.",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{filePath}}"
                },
                {
                  "key": "hindiFile",
                  "type": "file",
                  "src": "{{filePath}}"
                },
                {
                  "key": "titleEnglish",

                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"Sample Organization\",\n  \"organizationCode\": \"SAMPLE-ORG\",\n  \"organizationTypeId\": {{organizationTypeId}},\n  \"parentOrganizationId\": {{regionalOfficeId}},\n  \"regionId\": {{regionId}},\n  \"stateId\": {{stateId}},\n  \"address\": \"Sample address\"\n}"
            },
            "url": "{{baseUrl}}/api/organizations"
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations?page=1&limit=20"
          }
